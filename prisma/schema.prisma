// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Hashed password for Credentials provider
  role          String    @default("user") // "user" | "admin"
  is_approved   Boolean   @default(false)  // Approval logic replacement

  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Master Data: Kamus ----------

model Kamus {
  id                    String   @id @default(cuid())
  code                  String   @unique
  name                  String
  type                  String   // "potensi" | "kompetensi"
  description           String   @db.Text
  behavioralIndicators  String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdBy             String?
  updatedBy             String?

  standarJabatanItems   StandarJabatanItem[]
  scenarioItems         ScenarioItem[]
}

model KamusEvent {
  id          String   @id @default(cuid())
  eventType   String   // "Kamus Submitted"
  payload     String   @db.Text
  createdAt   DateTime @default(now())
  createdBy   String?
}

model StandarJabatan {
  id          String   @id @default(cuid())
  name        String   @unique
  level       String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       StandarJabatanItem[]
}

model StandarJabatanItem {
  id               String         @id @default(cuid())
  standarJabatanId String
  kamusId          String
  expectedLevel    Int            @default(1)

  standarJabatan   StandarJabatan @relation(fields: [standarJabatanId], references: [id], onDelete: Cascade)
  kamus            Kamus          @relation(fields: [kamusId], references: [id], onDelete: Restrict)

  @@unique([standarJabatanId, kamusId])
}

model Scenario {
  id           String   @id @default(cuid())
  name         String   @unique
  scenarioType String
  description  String?  @db.Text
  durationMin  Int?
  instructions String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items        ScenarioItem[]
}

model ScenarioItem {
  id         String   @id @default(cuid())
  scenarioId String
  kamusId    String

  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  kamus      Kamus    @relation(fields: [kamusId], references: [id], onDelete: Restrict)

  @@unique([scenarioId, kamusId])
}

// ---------- Project Management ----------

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String   @db.Text
  configuration String   @db.Text
  status        String   @default("draft") // draft | submitted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  batches       ProjectBatch[]
  assessors     ProjectAssessor[]
  invitations   ProjectInvitation[]
  events        ProjectEvent[]
}

model ProjectBatch {
  id        String   @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime @default(now())

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assessees ProjectAssessee[]
}

model ProjectAssessee {
  id        String   @id @default(cuid())
  batchId   String
  name      String
  email     String
  createdAt DateTime @default(now())

  batch       ProjectBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  invitations ProjectInvitation[]
}

model AssessorMaster {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments ProjectAssessor[]
}

model ProjectAssessor {
  id         String   @id @default(cuid())
  projectId  String
  assessorId String
  createdAt  DateTime @default(now())

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assessor   AssessorMaster @relation(fields: [assessorId], references: [id], onDelete: Restrict)

  @@unique([projectId, assessorId])
}

model ProjectInvitation {
  id         String    @id @default(cuid())
  projectId  String
  assesseeId String
  email      String
  status     String    @default("sent") // sent | delivered | expired
  sentAt     DateTime  @default(now())
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assessee   ProjectAssessee  @relation(fields: [assesseeId], references: [id], onDelete: Cascade)
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  eventType String   // Submit Project | Assessee Notified | Assessor Assigned
  payload   String   @db.Text
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
