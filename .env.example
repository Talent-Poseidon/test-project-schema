# Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=<NAMA_SCHEMA>
#
# IMPORTANT for Vercel/serverless deployments with connection pooler (Supabase, Neon, PgBouncer):
#
#   DATABASE_URL: Gunakan pooled connection (Supabase pooler)
#   WAJIB tambahkan ?pgbouncer=true jika menggunakan connection pooler
#   Tanpa ?pgbouncer=true, Prisma menggunakan prepared statements yang conflict
#   dengan connection poolers di transaction mode, menyebabkan:
#   "prepared statement does not exist" errors
#
#   DIRECT_URL: Gunakan direct connection (tanpa pooler)
#   Dipakai oleh Prisma CLI untuk migration dan introspection
#
# ── Per-Project Schema Isolation (shared Supabase setup) ─────────────────
# Pada CI workflow (.github/workflows/ci.yml), schema name di-derive otomatis
# dari nama repo + hash 6-char (format: proj_<repo_normalized>_<hash>),
# lalu di-suffix-kan ke URL via `?schema=<schema_name>` di runtime.
# Untuk local development, ganti `<NAMA_SCHEMA>` dengan nama bebas (mis. `public`)
# atau biarkan param dihilangkan → default ke `public`.
#
# Contoh untuk Supabase (shared, multi-project setup):
#   # GitHub Secret (RAW — tanpa ?schema=, CI yang inject):
#   DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
#
#   # Local .env (boleh manual pakai ?schema=public atau biarkan default):
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb?schema=public"
#   DIRECT_URL="postgresql://postgres:password@localhost:5432/mydb?schema=public"
#
# Untuk local development:
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/mydb"

# NextAuth Configuration
# Run `openssl rand -base64 32` to generate a secret
NEXTAUTH_SECRET="changeme_random_string_at_least_32_chars"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (Optional)
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
